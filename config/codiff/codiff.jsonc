{
  "$schema": "https://raw.githubusercontent.com/nkzw-tech/codiff/main/src/config/codiff-config.schema.json",
  "keymap": {
    "closeSearch": "Escape",
    "commandBar": "Mod+Shift+p",
    "diffSearch": "Mod+f",
    "discardComment": "Escape",
    "fileFilter": "Mod+p",
    "nextSearchMatch": "Enter",
    "openFile": "Mod+k",
    "prevSearchMatch": "Shift+Enter",
    "submitComment": "Mod+Enter",
    "toggleSidebar": "Mod+b"
  },
  "settings": {
    "copyCommentsOnClose": true,
    "diffStyle": "unified",
    "editorCommand": "\"/Applications/Sublime Text.app/Contents/SharedSupport/bin/subl\" \"{repo}\" \"{file}\"",
    "lastRepositoryPath": "/Users/gumadeiras/git/oss/codiff",
    "openAIModel": "gpt-5.3-codex-spark",
    "showOutdated": false,
    "showWhitespace": false,
    "theme": "system",
    "wordWrap": true
  }
}
