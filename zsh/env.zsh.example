# Copy this loader to ~/.config/secrets/env.zsh; never add secret values here.
# Store values in Personal / Shell Environment in 1Password, with exact env names.
# Requires 1Password CLI access and jq. Access errors stop this loader.
() {
  setopt local_options pipefail
  local environment_exports
  environment_exports="$(
    op item get 'Shell Environment' --vault 'Personal' --format=json |
      jq -er '
        [.fields[] | select(.label | test("^[A-Z_][A-Z0-9_]*$")) |
          "export \(.label)=\(.value | @sh)"] |
        if length > 0 then join("\n") else error("No environment fields found") end
      '
  )" || return
  eval "$environment_exports"
}
